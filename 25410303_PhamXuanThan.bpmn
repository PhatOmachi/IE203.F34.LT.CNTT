<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FPTShop_IT_Clean" targetNamespace="http://fptshop.vn/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <process id="FPTShop_ITSupport_Clean" name="Quy trình hỗ trợ Công nghệ thông tin tại FPT Shop" isExecutable="false">
    <laneSet id="LaneSet_Clean">
      <lane id="Lane_Manager" name="Quản lý IT">
        <flowNodeRef>Approve</flowNodeRef>
        <flowNodeRef>Escalate</flowNodeRef>
        <flowNodeRef>Fix</flowNodeRef>
      </lane>
      <lane id="Lane_Tech" name="Kỹ thuật viên IT">
        <flowNodeRef>Diagnose</flowNodeRef>
        <flowNodeRef>RequestAccess</flowNodeRef>
        <flowNodeRef>G4</flowNodeRef>
        <flowNodeRef>G5</flowNodeRef>
        <flowNodeRef>G6</flowNodeRef>
        <flowNodeRef>Test</flowNodeRef>
        <flowNodeRef>Replace</flowNodeRef>
      </lane>
      <lane id="Lane_Helpdesk" name="IT Helpdesk">
        <flowNodeRef>Assign</flowNodeRef>
        <flowNodeRef>Urgent</flowNodeRef>
        <flowNodeRef>Classify</flowNodeRef>
        <flowNodeRef>Receive</flowNodeRef>
        <flowNodeRef>Close</flowNodeRef>
        <flowNodeRef>Reopen</flowNodeRef>
        <flowNodeRef>G3</flowNodeRef>
        <flowNodeRef>G2</flowNodeRef>
        <flowNodeRef>G7</flowNodeRef>
        <flowNodeRef>Remote</flowNodeRef>
      </lane>
      <lane id="Lane_Employee" name="Nhân viên / Cửa hàng">
        <flowNodeRef>Confirm</flowNodeRef>
        <flowNodeRef>End</flowNodeRef>
        <flowNodeRef>G8</flowNodeRef>
        <flowNodeRef>Supplement</flowNodeRef>
        <flowNodeRef>G1</flowNodeRef>
        <flowNodeRef>Report</flowNodeRef>
        <flowNodeRef>Start</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="Start" name="Phát sinh sự cố / yêu cầu CNTT" />
    <task id="Report" name="Gửi yêu cầu hỗ trợ CNTT" />
    <exclusiveGateway id="G1" name="Yêu cầu hợp lệ?" />
    <task id="Supplement" name="Bổ sung thông tin" />
    <task id="Confirm" name="Xác nhận kết quả hỗ trợ" />
    <exclusiveGateway id="G8" name="Người dùng xác nhận?" />
    <endEvent id="End" name="Kết thúc quy trình" />
    <task id="Receive" name="Tiếp nhận và tạo phiếu" />
    <task id="Classify" name="Phân loại sự cố / yêu cầu" />
    <exclusiveGateway id="G2" name="Mức độ ưu tiên?" />
    <task id="Urgent" name="Ưu tiên xử lý khẩn" />
    <exclusiveGateway id="G3" name="Có thể xử lý từ xa?" />
    <task id="Remote" name="Hỗ trợ và xử lý từ xa" />
    <task id="Assign" name="Phân công kỹ thuật viên" />
    <exclusiveGateway id="G7" name="Cần nâng cấp xử lý?" />
    <task id="Reopen" name="Mở lại / tiếp tục xử lý phiếu" />
    <task id="Close" name="Cập nhật kết quả và đóng phiếu" />
    <task id="Diagnose" name="Kiểm tra và chẩn đoán" />
    <exclusiveGateway id="G4" name="Cần quyền truy cập / phê duyệt?" />
    <task id="RequestAccess" name="Yêu cầu cấp quyền / phê duyệt" />
    <exclusiveGateway id="G5" name="Cần thay thế thiết bị?" />
    <task id="Replace" name="Thay thế / sửa thiết bị" />
    <task id="Fix" name="Khắc phục phần mềm / mạng / cấu hình">
      <incoming>F19</incoming>
    </task>
    <task id="Test" name="Kiểm tra và kiểm thử" />
    <exclusiveGateway id="G6" name="Đã khắc phục?" />
    <task id="Escalate" name="Tiếp nhận yêu cầu nâng cấp" />
    <task id="Approve" name="Phê duyệt phương án xử lý" />
    <sequenceFlow id="F01" sourceRef="Start" targetRef="Report" />
    <sequenceFlow id="F02" sourceRef="Report" targetRef="G1" />
    <sequenceFlow id="F03" name="Không" sourceRef="G1" targetRef="Supplement" />
    <sequenceFlow id="F04" sourceRef="Supplement" targetRef="Report" />
    <sequenceFlow id="F05" name="Có" sourceRef="G1" targetRef="Receive" />
    <sequenceFlow id="F06" sourceRef="Receive" targetRef="Classify" />
